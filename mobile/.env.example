# Copia este archivo a .env y completa con los datos de tu proyecto de
# Supabase de staging (ver docs/TESTING_ENVIRONMENT.md). Sin estas variables
# la app funciona igual, 100% local con AsyncStorage — son solo necesarias
# para el siguiente paso: sincronización familiar real.

EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
